Windows Registry Editor Version 5.00

; Registra o protocolo gmaisvnc:// para o PC atual (nao precisa de admin).
; Ver util\LEIA-ME-VNC.txt

[HKEY_CURRENT_USER\Software\Classes\gmaisvnc]
@="URL:Gmais VNC"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\gmaisvnc\DefaultIcon]
@="C:\\Util\\VNCViewer.exe,0"

[HKEY_CURRENT_USER\Software\Classes\gmaisvnc\shell]

[HKEY_CURRENT_USER\Software\Classes\gmaisvnc\shell\open]

[HKEY_CURRENT_USER\Software\Classes\gmaisvnc\shell\open\command]
@="\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"C:\\Util\\gmais-vnc.ps1\" \"%1\""
