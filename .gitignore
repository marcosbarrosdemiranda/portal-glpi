# ─────────────────────────────────────────────────────────────
#  .gitignore — portal-glpi
# ─────────────────────────────────────────────────────────────

# ── Credenciais e configurações sensíveis ─────────────────────
# NUNCA versionar — contém senhas, tokens e caminhos de servidor
agenda/config.php
config_db_prod.php

# Certificado Let's Encrypt (chave privada) — gerado localmente via certbot
docker/certbot-etc/
docker/certbot-log/
docker/certbot-hooks/txt_record.txt

# ── Ferramentas de debug ───────────────────────────────────────
# Expõem informações internas; não devem ir para produção
debug_login.php
debug_proxy.php
debug_docs.php
agenda/debug_db.php

# ── Backups e arquivos de documentação gerados ────────────────
Documentação e Backup*/
*.zip
*.bak
*.sql

# ── Ambiente local do Claude Code ─────────────────────────────
.claude/

# ── Obsidian (vault) ─────────────────────────────────────────
# TODO: Se for usar Portal-Glpi/ como vault, abrir manualmente no Obsidian
**/.obsidian/
*.canvas

# ── Sistema operacional ────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Configurações locais de projetos ────────────────────────────
config_projetos.local.php

# ── Logs e temporários ────────────────────────────────────────
*.log
*.tmp
*.cache

# ── Dependências (se vier a usar composer/npm) ─────────────────
/vendor/
/node_modules/

# ── Binários de terceiros servidos pelo portal (deploy via scp) ─
util/VNCViewer.exe

# Instalador do GLPI Agent (baixe do GitHub releases do glpi-agent, ~22MB)
util/Instaladores - AD/*.msi
util/Instaladores/*.msi

# Spec-Driven Agent
.claude/sda/hooks/state.json
.claude/sda/hooks/state.history.log

# ── Workspace de execução do superpowers (subagent-driven-development) ──
.superpowers/
